<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
    <!-- Build the helper, but do not load it here: tests run it as a separate process. -->
    <ProjectReference Include="../Helper/Helper.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Core/Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- AssetsReaderTests run AssetsReader in this process. Its source is linked: the helper is not loaded.
         NuGet.ProjectModel is a runtime reference of the tests only. The helper project does not change. -->
    <PackageReference Include="NuGet.ProjectModel" Version="6.0.0" NoWarn="NU1903" />
    <Compile Include="../Helper/Projects/AssetsReader.cs" Link="Linked/AssetsReader.cs" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HelperDll</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../Helper/bin/$(Configuration)/net6.0/Helper.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
