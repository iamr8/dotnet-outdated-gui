<idea-plugin>
    <id>com.github.iamr8.dotnetoutdated</id>
    <name>NuGet (Extended)</name>
    <vendor url="https://github.com/iamr8" email="arash.shabbeh@gmail.com">iamr8</vendor>

    <description><![CDATA[
        <p>Keep a solution's NuGet packages up to date without leaving Rider. <b>NuGet (Extended)</b> adds what
        Rider's NuGet window does not do yet: solution-wide update checks and upgrades that keep your
        <b>version ranges</b> and work with <b>Central Package Management</b>.</p>

        <ul>
          <li><b>Version ranges stay ranges</b> - <code>[12.0.1,14.0.0)</code> upgrades to
              <code>[13.0.4,14.0.0)</code>, not to a fixed version. The new version is the newest one inside the
              range; a version above the upper bound is never offered.</li>
          <li><b>Central Package Management</b> - updates the central <code>&lt;PackageVersion&gt;</code> in
              <code>Directory.Packages.props</code> (or a <code>VersionOverride</code>) and leaves the versionless
              <code>&lt;PackageReference&gt;</code> alone.</li>
          <li><b>Versions in properties</b> - <code>Version="$(PollyVersion)"</code> updates the property; other
              packages that share it are listed before anything changes.</li>
          <li><b>Floating versions</b> (<code>3.*</code>) update through a restore, with no file edit.</li>
          <li><b>Severity at a glance</b> - green for patch, yellow for minor, red for major or pre-release.</li>
        </ul>

        <p>Packages are grouped by project and target framework. Check the ones you want, see the plan, and
        upgrade. One Undo reverts every file. Pre-release, version lock, maximum version, transitive packages
        and filters are under <b>Settings &rarr; Tools &rarr; NuGet (Extended)</b>.</p>

        <p>No extra tool to install: the plugin uses your .NET SDK's own MSBuild and NuGet (the .NET 6 SDK or
        later), with your NuGet.config, package source mapping and credential providers.</p>

        <p>Source &amp; issues: <a href="https://github.com/iamr8/dotnet-outdated-gui">github.com/iamr8/dotnet-outdated-gui</a></p>
    ]]></description>

    <change-notes><![CDATA[
        See the <a href="https://github.com/iamr8/dotnet-outdated-gui/blob/main/CHANGELOG.md">CHANGELOG</a>
        for release notes.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!--
          Opt in to the JetBrains Marketplace Exception Analyzer: when the user chooses to report a
          plugin exception, it is delivered to the plugin's "Exceptions" tab on the Marketplace.
          Platform-provided (since 2023.3) — no third-party service, no extra dependency.
        -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <editorNotificationProvider implementation="com.github.iamr8.nugetextended.ui.DotnetProjectNotificationProvider"/>

        <!-- Balloons for dotnet CLI / user-project failures (not plugin bugs). -->
        <notificationGroup id="NuGet (Extended)" displayType="BALLOON"/>

        <!--
          Marketplace Plugin Advertiser: Rider's dotnet dependency collector matches a project's
          NuGet references against these coordinates and suggests installing this plugin (once
          published). Covers ubiquitous packages so most real .NET solutions trigger it.
        -->
        <dependencySupport kind="dotnet" coordinate="Newtonsoft.Json" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="Microsoft.Extensions.DependencyInjection" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="Microsoft.Extensions.Hosting" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="Microsoft.EntityFrameworkCore" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="Microsoft.AspNetCore.App" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="Serilog" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="Swashbuckle.AspNetCore" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="AutoMapper" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="FluentValidation" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="MediatR" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="Dapper" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="Polly" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="xunit" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="NUnit" displayName="NuGet"/>
        <dependencySupport kind="dotnet" coordinate="Moq" displayName="NuGet"/>
        <projectConfigurable
            parentId="tools"
            id="nuget.extended"
            displayName="NuGet (Extended)"
            instance="com.github.iamr8.nugetextended.settings.OutdatedConfigurable"/>
        <toolWindow
            id="NuGet (Extended)"
            anchor="right"
            icon="/icons/nugetExtended.svg"
            factoryClass="com.github.iamr8.nugetextended.ui.OutdatedToolWindowFactory"/>
    </extensions>

    <projectListeners>
        <!-- Project, props, targets, global.json and NuGet.config changes -> the engine's cache. -->
        <listener class="com.github.iamr8.nugetextended.engine.FileWatch"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>
</idea-plugin>
